            {
              "id": "ohgrabody01",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"thanks-container section-copy\" style=\"text-align: center;\">\n  <p class=\"thanks-lead\">\n    Escríbele a nuestra ejecutiva para coordinar la hora y la dirección donde te pasamos a buscar el sábado 5 de diciembre. También puede responder todas tus dudas sobre Alto Zañartu antes de la visita.\n  </p>\n  <p class=\"thanks-closing\">¡Nos vemos pronto!</p>\n</div>"
              }
            }
          ]
        },
        {
          "id": "ohgrafoot01",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<footer class=\"site-footer section-copy\">\n    <div class=\"footer-container\">\n      <div class=\"footer-info-grid\">\n        <div class=\"footer-col\">\n          <span class=\"footer-col-label\">Proyecto y Respaldo</span>\n          <div class=\"footer-brand-pair\">\n            <img\n              src=\"https://lupdesign.github.io/landing-alto-zanartu/assets/logos/logotipo.svg\"\n              alt=\"Alto Zañartu\"\n              class=\"footer-logo-az\"\n              loading=\"lazy\"\n            />\n            <span class=\"footer-logo-divider\" aria-hidden=\"true\"></span>\n            <img\n              src=\"https://lupdesign.github.io/landing-alto-zanartu/media/logo%20vector%20.svg\"\n              alt=\"Constructora Vector\"\n              class=\"footer-logo-vector\"\n              loading=\"lazy\"\n            />\n          </div>\n        </div>\n\n        <div class=\"footer-col\">\n          <span class=\"footer-col-label\">Comercializa</span>\n          <img\n            src=\"https://lupdesign.github.io/landing-alto-zanartu/media/logo%20onekey.svg\"\n            alt=\"OneKey\"\n            class=\"footer-logo-onekey\"\n            loading=\"lazy\"\n          />\n        </div>\n\n        <a href=\"#\" class=\"footer-back-top\">Volver arriba</a>\n      </div>\n\n      <div class=\"footer-bottom-bar\">\n        <span>© 2026 Constructora Vector. Todos los derechos reservados</span>\n        <span>Corregidor Zañartu 11544, La Florida</span>\n      </div>\n    </div>\n  </footer>"
          }
